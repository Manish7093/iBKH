def _repo_cache_path(repo_id):
    """Get the HuggingFace cache path for a repo ID."""
    return HF_CACHE_DIR / ("models--" + repo_id.replace("/", "--"))


def _is_repo_cached(repo_id):
    """True when a HuggingFace repo has a populated snapshot on disk.

    An empty models--*/ directory is created early during a download, long
    before anything usable is in it, so the snapshot contents have to be
    checked rather than the top directory.
    """
    if not repo_id:
        return False

    snapshots = _repo_cache_path(repo_id) / "snapshots"
    if not snapshots.is_dir():
        return False

    try:
        for snapshot in snapshots.iterdir():
            if not snapshot.is_dir():
                continue
            for _entry in snapshot.iterdir():
                return True
    except OSError:
        return False

    return False


# ---------------------------------------------------------------------------
# Shared loader helpers
#
# Both the download path and the engine load models. They must agree on the
# quantization, otherwise downloading int8 and then loading fp32 silently
# fetches the model a second time.
# ---------------------------------------------------------------------------

def stt_onnxasr_quantization():
    """Quantization variant to request, or None for full precision."""
    value = os.getenv("IBUS_STT_ONNXASR_QUANTIZATION", "int8").strip()
    if value.lower() in ("", "none", "fp32", "float32"):
        return None
    return value


def _intra_op_threads():
    override = os.getenv("IBUS_STT_ONNXASR_THREADS")
    if override:
        try:
            return max(1, int(override))
        except ValueError:
            pass
    return max(1, min(4, os.cpu_count() or 1))


def stt_onnxasr_session_options():
    """SessionOptions tuned for a desktop background service.

    ONNX Runtime's default CPU arena allocator grows aggressively and never
    returns memory to the OS. On a machine with many cores that alone accounts
    for a large part of the resident size of an otherwise idle recognizer.
    """
    try:
        import onnxruntime as ort
    except ImportError:
        return None

    try:
        options = ort.SessionOptions()
        options.enable_cpu_mem_arena = False
        options.enable_mem_pattern = False
        options.intra_op_num_threads = _intra_op_threads()
        options.inter_op_num_threads = 1
        return options
    except Exception as error:
        LOG_MSG.warning("cannot build onnxruntime session options (%s)", error)
        return None


_QUANTIZATION_UNSET = object()


def stt_onnxasr_load_recognizer(model_name, quantization=_QUANTIZATION_UNSET):
    """Load a model, preferring the quantized artefact when one exists.

    onnx_asr is imported here rather than at module scope so that onnxruntime
    is only initialised when a model is genuinely needed, and never on the
    GTK main loop. Callers must run this off the main thread.

    load_model()'s signature differs between onnx-asr releases, so the
    accepted keywords are probed instead of assumed.
    """
    import onnx_asr

    if quantization is _QUANTIZATION_UNSET:
        quantization = stt_onnxasr_quantization()

    try:
        params = inspect.signature(onnx_asr.load_model).parameters
    except (TypeError, ValueError):
        params = {}

    base_kwargs = {}
    if "sess_options" in params:
        options = stt_onnxasr_session_options()
        if options is not None:
            base_kwargs["sess_options"] = options

    attempts = []
    if quantization is not None and "quantization" in params:
        attempts.append(dict(base_kwargs, quantization=quantization))
    attempts.append(dict(base_kwargs))

    last_error = None
    for kwargs in attempts:
        variant = kwargs.get("quantization", "fp32")
        try:
            LOG_MSG.info("loading onnx-asr model %s (%s)", model_name, variant)
            return onnx_asr.load_model(model_name, **kwargs)
        except Exception as error:
            last_error = error
            LOG_MSG.warning("cannot load %s as %s (%s)",
                            model_name, variant, error)

    raise last_error


class STTDownloadState(float, Enum):
    STOPPED = -1.0
    UNKNOWN_PROGRESS = -0.5
    UNPACKING = -0.6
    ONGOING = 0.0


class STTOnnxAsrModelDescription(GObject.Object):
    __gtype_name__ = "STTOnnxAsrModelDescription"

    def __init__(self, init_model=None):
        super().__init__()
        self.name = init_model.name if init_model is not None else ""
        self.custom = init_model.custom if init_model is not None else False
        self.is_obsolete = False
        self.paths = init_model.paths if init_model is not None else []
        self.size = init_model.size if init_model is not None else ""
        self.type = init_model.type if init_model is not None else ""
        self.locale = init_model.locale if init_model is not None else ""
        self.url = init_model.url if init_model is not None else ""
        self.repo_id = init_model.repo_id if init_model is not None else ""

        self._operation = None
        self.download_progress = STTDownloadState.STOPPED

    def _download_finished(self):
        # Unconditionally: clearing this only on cancellation left _operation
        # set forever after a successful download, and start_downloading()
        # then returned early for the rest of the process' life.
        self._operation = None
        self.download_progress = STTDownloadState.STOPPED
        return False

    def _download_model_thread(self, model_name, status):
        recognizer = None
        try:
            self.download_progress = STTDownloadState.UNKNOWN_PROGRESS

            if status.is_cancelled():
                self.download_progress = STTDownloadState.STOPPED
                GLib.idle_add(self._download_finished)
                return

            # load_model() fetches from HuggingFace when the repo is not
            # cached. The session it builds is thrown away immediately: this
            # call is only here for its download side effect.
            recognizer = stt_onnxasr_load_recognizer(model_name)

            if status.is_cancelled():
                self.download_progress = STTDownloadState.STOPPED
                GLib.idle_add(self._download_finished)
                return

            if self.repo_id:
                cache_path = _repo_cache_path(self.repo_id)
                if cache_path.is_dir():
                    self.paths = [str(cache_path)]

            # The GFileMonitor on the cache root is not recursive and cannot
            # observe the writes under models--*/snapshots/, so publish the
            # result explicitly. Without this the model only becomes selectable
            # after an ibus restart.
            GLib.idle_add(stt_onnxasr_local_model_manager().refresh)

        except Exception as error:
            LOG_MSG.error("download error for %s (%s)", model_name, error)
        finally:
            recognizer = None
            gc.collect()

        self.download_progress = STTDownloadState.STOPPED
        GLib.idle_add(self._download_finished)

    def stop_downloading(self):
        if self._operation is not None:
            self._operation.cancel()

    def start_downloading(self):
        if self._operation is not None:
            return

        LOG_MSG.debug("start downloading onnx-asr model (%s)", self.name)

        self.download_progress = STTDownloadState.ONGOING
        self._operation = Gio.Cancellable()

        download_thread = threading.Thread(
            target=self._download_model_thread,
            args=(self.name, self._operation),
            name="onnxasr-download",
            daemon=True)
        download_thread.start()

    def get_best_path_for_model(self):
        if self.paths in [None, []]:
            return None
        return self.paths[0]

    def delete_paths(self):
        if self.custom is True:
            return

        if not self.repo_id:
            return

        cache_path = _repo_cache_path(self.repo_id)
        if cache_path.is_dir():
            try:
                shutil.rmtree(cache_path)
            except Exception as error:
                LOG_MSG.error("failed to delete %s (%s)", cache_path, error)

        self._operation = None
        self.download_progress = STTDownloadState.STOPPED
        self.paths = []

        # Symmetric with the download path: tell the local manager rather than
        # relying on a monitor event that will not arrive.
        GLib.idle_add(stt_onnxasr_local_model_manager().refresh)


class STTOnnxAsrLocalModelManager(GObject.Object):
    __gtype_name__ = "STTOnnxAsrLocalModelManager"

    __gsignals__ = {
        "added": (GObject.SIGNAL_RUN_FIRST, None, (str, str,)),
        "removed": (GObject.SIGNAL_RUN_FIRST, None, (str, str,)),
    }

    def __init__(self):
        super().__init__()
        self._monitors = []
        self._models_dict = {}
        self._locales_dict = {}
        self._custom_models = {}
        self._pending_polls = set()
        self._scan_cached_models()
        self._setup_monitor()

    def _add_model_description_to_locale(self, model_desc):
        if model_desc.locale is None:
            return

        models_list = self._locales_dict.get(model_desc.locale, None)
        if models_list is None:
            self._locales_dict[model_desc.locale] = [model_desc]
        else:
            models_list.append(model_desc)

    def _remove_model_description_from_locale(self, model_desc):
        models_list = self._locales_dict.get(model_desc.locale, [])
        if model_desc in models_list:
            models_list.remove(model_desc)
        if not any(models_list):
            self._locales_dict.pop(model_desc.locale, None)

    def _new_catalog_description(self, model_name, locale, size, repo_id):
        model_desc = STTOnnxAsrModelDescription()
        model_desc.name = model_name
        model_desc.locale = locale
        model_desc.size = size
        model_desc.repo_id = repo_id
        model_desc.paths = [str(_repo_cache_path(repo_id))]
        model_desc.type = model_name.split("-")[0] if "-" in model_name else model_name
        return model_desc

    def _scan_cached_models(self):
        """Scan the HuggingFace cache for known onnx-asr models (no signals)."""
        for model_name, (locale, size, repo_id) in ONNXASR_MODELS.items():
            if model_name in self._models_dict:
                continue

            if _is_repo_cached(repo_id):
                model_desc = self._new_catalog_description(
                    model_name, locale, size, repo_id)
                self._models_dict[model_name] = model_desc
                self._add_model_description_to_locale(model_desc)
                LOG_MSG.debug("found cached onnx-asr model: %s at %s",
                              model_name, model_desc.paths[0])

    def refresh(self):
        """Re-scan the cache and emit for anything that appeared or vanished.

        Safe to use directly as a GLib idle or timeout callback.
        """
        added = []
        removed = []

        for model_name, (locale, size, repo_id) in ONNXASR_MODELS.items():
            cached = _is_repo_cached(repo_id)
            known = self._models_dict.get(model_name, None)

            if cached and known is None:
                model_desc = self._new_catalog_description(
                    model_name, locale, size, repo_id)
                self._models_dict[model_name] = model_desc
                self._add_model_description_to_locale(model_desc)
                added.append((model_name, model_desc.paths[0]))

            elif not cached and known is not None and not known.custom:
                self._models_dict.pop(model_name, None)
                self._remove_model_description_from_locale(known)
                removed.append((model_name, str(_repo_cache_path(repo_id))))

        # Custom entries stay registered whether or not they are on disk; only
        # their paths change.
        for model_name in list(self._custom_models):
            model_desc = self._models_dict.get(model_name, None)
            if model_desc is None:
                continue

            cached = _is_repo_cached(model_desc.repo_id)
            if cached and not model_desc.paths:
                model_desc.paths = [str(_repo_cache_path(model_desc.repo_id))]
                added.append((None, model_name))
            elif not cached and model_desc.paths:
                model_desc.paths = []
                removed.append((None, model_name))

        for name, path in removed:
            LOG_MSG.info("onnx-asr model removed: %s", name or path)
            self.emit("removed", name, path)

        for name, path in added:
            LOG_MSG.info("onnx-asr model now available: %s", name or path)
            self.emit("added", name, path)

        return False

    def _setup_monitor(self):
        """Monitor the HuggingFace cache directory for changes."""
        try:
            HF_CACHE_DIR.mkdir(parents=True, exist_ok=True)
        except OSError:
            LOG_MSG.warning("cannot create HuggingFace cache directory: %s",
                            HF_CACHE_DIR)
            return

        try:
            monitor = Gio.File.new_for_path(str(HF_CACHE_DIR)).monitor_directory(
                Gio.FileMonitorFlags.NONE, None)
        except GLib.Error as error:
            LOG_MSG.warning("cannot monitor %s (%s)", HF_CACHE_DIR, error)
            return

        monitor.connect("changed", self._cache_dir_changed_cb)
        self._monitors.append(monitor)

    def _poll_for_repo(self, repo_id, model_name, attempts):
        """Poll a models--*/ directory until its snapshot is populated.

        Gio.FileMonitor is not recursive here, so the only event seen is the
        creation of the top level directory, which happens before there is
        anything usable inside it.
        """
        if model_name in self._models_dict:
            self._pending_polls.discard(model_name)
            return False

        if _is_repo_cached(repo_id):
            self._pending_polls.discard(model_name)
            self.refresh()
            return False

        attempts[0] -= 1
        if attempts[0] <= 0:
            LOG_MSG.debug("gave up waiting for %s to appear in the cache",
                          model_name)
            self._pending_polls.discard(model_name)
            return False

        return True

    def _cache_dir_changed_cb(self, monitor, file, other_file, event_type):
        if event_type not in (Gio.FileMonitorEvent.CREATED,
                              Gio.FileMonitorEvent.DELETED,
                              Gio.FileMonitorEvent.CHANGES_DONE_HINT):
            return

        dir_name = file.get_basename()

        for model_name, (locale, size, repo_id) in ONNXASR_MODELS.items():
            if dir_name != "models--" + repo_id.replace("/", "--"):
                continue

            if event_type == Gio.FileMonitorEvent.DELETED:
                self.refresh()
                return

            if model_name in self._models_dict:
                return

            if _is_repo_cached(repo_id):
                self.refresh()
                return

            # The directory exists but the snapshot is still being written.
            if model_name in self._pending_polls:
                return

            self._pending_polls.add(model_name)
            attempts = [300]                    # ~10 minutes at 2s intervals
            GLib.timeout_add_seconds(2, self._poll_for_repo,
                                     repo_id, model_name, attempts)
            return

    def path_available(self, model_name):
        # Being registered is not the same as being on disk: a custom repo ID
        # is registered as soon as it is typed into the model chooser, long
        # before anything has been downloaded.
        model_desc = self._models_dict.get(model_name, None)
        if model_desc is None:
            return False
        if model_desc.paths:
            return True
        return _is_repo_cached(model_desc.repo_id)

    def get_models_for_locale(self, locale_str):
        models = self._locales_dict.get(locale_str, []).copy()
        if locale_str != "multilingual":
            models.extend(self._locales_dict.get("multilingual", []))
        return models

    def get_best_path_for_model(self, model_name):
        if model_name is None:
            return None

        if not self.path_available(model_name):
            return None

        # For onnx-asr the "path" is the model name identifier that gets handed
        # back to onnx_asr.load_model().
        return model_name

    def get_model_description(self, model_name):
        return self._models_dict.get(model_name, None)

    def get_supported_locales(self):
        return list(self._locales_dict.keys())

    def register_custom_model_path(self, model_name, locale_str):
        """Register a custom HuggingFace model repo ID."""
        if model_name in ONNXASR_MODELS:
            LOG_MSG.debug("registered a catalog model name (%s)", model_name)
            return

        if model_name in self._custom_models:
            self._custom_models[model_name] += 1
            LOG_MSG.debug("custom model already registered (%s). "
                          "Increasing refcount (%i).",
                          model_name, self._custom_models[model_name])
            return

        self._custom_models[model_name] = 1

        # For custom models, repo_id is the model name itself (a HF repo path)
        model_desc = STTOnnxAsrModelDescription()
        model_desc.name = model_name
        model_desc.custom = True
        model_desc.locale = locale_str
        model_desc.repo_id = model_name

        if _is_repo_cached(model_name):
            model_desc.paths = [str(_repo_cache_path(model_name))]

        self._models_dict[model_name] = model_desc
        self._add_model_description_to_locale(model_desc)
        self.emit("added", None, model_name)

    def unregister_custom_model_path(self, model_name):
        if model_name not in self._custom_models:
            LOG_MSG.debug("trying to unregister unknown custom model (%s)",
                          model_name)
            return

        if self._custom_models[model_name] != 1:
            LOG_MSG.debug("refcount of custom model not 0 yet (%s)", model_name)
            self._custom_models[model_name] -= 1
            return

        self._custom_models.pop(model_name, None)

        model_desc = self._models_dict.pop(model_name, None)
        if model_desc is not None:
            self._remove_model_description_from_locale(model_desc)
            self.emit("removed", None, model_name)


_GLOBAL_LOCAL_MANAGER = None

def stt_onnxasr_local_model_manager():
    global _GLOBAL_LOCAL_MANAGER
    if _GLOBAL_LOCAL_MANAGER is None:
        _GLOBAL_LOCAL_MANAGER = STTOnnxAsrLocalModelManager()
    return _GLOBAL_LOCAL_MANAGER


class STTOnnxAsrOnlineModelManager(GObject.Object):
    __gtype_name__ = "STTOnnxAsrOnlineModelManager"
    __gsignals__ = {
        "added": (GObject.SIGNAL_RUN_FIRST, None, (object,)),
        "changed": (GObject.SIGNAL_RUN_FIRST, None, (object,)),
        "removed": (GObject.SIGNAL_RUN_FIRST, None, (object,)),
    }

    def __init__(self):
        super().__init__()

        self._locales_dict = {}
        self._online_models = {}

        local_manager = stt_onnxasr_local_model_manager()
        local_manager.connect("added", self._model_added_cb)
        local_manager.connect("removed", self._model_removed_cb)
        self._populate_with_onnxasr_models()

    def _populate_with_onnxasr_models(self):
        for model_name, (locale, size, repo_id) in ONNXASR_MODELS.items():
            model_desc = STTOnnxAsrModelDescription()
            model_desc.name = model_name
            model_desc.locale = locale
            model_desc.size = size
            model_desc.repo_id = repo_id
            model_desc.type = model_name.split("-")[0] if "-" in model_name else model_name
            # STTModelRow only shows the download/delete button when url is
            # non-empty, so expose the HuggingFace repo page as the URL marker.
            model_desc.url = "https://huggingface.co/" + repo_id

            LOG_MSG.debug("adding online onnx-asr model (%s)", model_name)

            local_desc = stt_onnxasr_local_model_manager().get_model_description(model_name)
            if local_desc is not None:
                model_desc.paths = local_desc.paths

            self._online_models[model_name] = model_desc
            self._add_model_description_to_locale(model_desc)

        # Add locally-available custom models not in catalog
        for locale in stt_onnxasr_local_model_manager().get_supported_locales():
            model_list = stt_onnxasr_local_model_manager().get_models_for_locale(locale)
            for model_desc in model_list:
                key = model_desc.name
                if key in self._online_models:
                    continue

                LOG_MSG.debug("adding local custom model to online dict (%s)", key)
                self._online_models[key] = model_desc
                self._add_model_description_to_locale(model_desc)

    def _add_model_description_to_locale(self, model_desc):
        locale_models = self._locales_dict.get(model_desc.locale, None)

        if locale_models is None:
            self._locales_dict[model_desc.locale] = [model_desc]
        else:
            locale_models.append(model_desc)

    def _model_added_cb(self, manager, model_name, model_path):
        if model_name is not None:
            online_model_desc = self._online_models.get(model_name, None)
            local_model_desc = manager.get_model_description(model_name)
        else:
            online_model_desc = self._online_models.get(model_path, None)
            local_model_desc = manager.get_model_description(model_path)

        if online_model_desc is not None:
            if online_model_desc.paths in [None, []]:
                online_model_desc.paths = local_model_desc.paths if local_model_desc else []

            self.emit("changed", online_model_desc)
            return

        if local_model_desc is not None:
            key = local_model_desc.name
            self._online_models[key] = local_model_desc
            self._add_model_description_to_locale(local_model_desc)
            self.emit("added", local_model_desc)

    def _remove_model_description_from_locale(self, model_desc):
        locale_models = self._locales_dict.get(model_desc.locale, None)
        if locale_models and model_desc in locale_models:
            locale_models.remove(model_desc)
        if locale_models is not None and not any(locale_models):
            self._locales_dict.pop(model_desc.locale, None)

    def _model_removed_cb(self, manager, model_name, model_path):
        if model_name is None:
            online_model_desc = self._online_models.get(model_path, None)
            if online_model_desc is None:
                return

            online_model_desc.paths = []

            # A custom repo ID stays listed while the model object holds a
            # reference to it; only drop it once it is unregistered.
            if manager.get_model_description(model_path) is not None:
                self.emit("changed", online_model_desc)
                return

            self._online_models.pop(model_path, None)
            self._remove_model_description_from_locale(online_model_desc)
            self.emit("removed", online_model_desc)
            return

        online_model_desc = self._online_models.get(model_name, None)
        if online_model_desc is None:
            return

        online_model_desc.paths = []

        # Catalog models stay listed even when not downloaded
        if model_name in ONNXASR_MODELS:
            self.emit("changed", online_model_desc)
            return

        self._online_models.pop(model_name, None)
        self._remove_model_description_from_locale(online_model_desc)
        self.emit("removed", online_model_desc)

    def get_model_description(self, model_name):
        return self._online_models.get(model_name, None)

    def get_models_for_locale(self, locale_str):
        models = self._locales_dict.get(locale_str, []).copy()
        if locale_str != 'multilingual':
            multilingual = self._locales_dict.get('multilingual', [])
            models.extend(multilingual)
        return models

    def supported_locales(self):
        return list(self._locales_dict.keys())


_GLOBAL_ONLINE_MANAGER = None

def stt_onnxasr_online_model_manager():
    global _GLOBAL_ONLINE_MANAGER
    if _GLOBAL_ONLINE_MANAGER is None:
        _GLOBAL_ONLINE_MANAGER = STTOnnxAsrOnlineModelManager()
    return _GLOBAL_ONLINE_MANAGER




