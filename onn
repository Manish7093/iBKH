import json
import logging

from gi.repository import GObject, Gio
from sttonnxasrmodelmanagers import stt_onnxasr_local_model_manager

LOG_MSG = logging.getLogger()

class STTOnnxAsrModel(GObject.Object):
    __gtype_name__ = "STTOnnxAsrModel"
    __gsignals__ = {
        "changed": (GObject.SIGNAL_RUN_FIRST, None, ()),
    }

    def __init__(self, locale_str=None):
        super().__init__()

        self._locale_str = locale_str
        self._settings_id = 0
        self._model_added_id = 0
        self._model_removed_id = 0

        self._settings = Gio.Settings.new("org.freedesktop.ibus.engine.stt")
        self._settings_id = self._settings.connect("changed::onnxasr-models",
                                                   self._models_changed)

        self._model_name = None
        self._model_path = None
        self._valid_model = False

        model = self._get_model_from_settings()
        self._set_model(model)

        manager = stt_onnxasr_local_model_manager()
        self._model_added_id = manager.connect("added", self._model_added_cb)
        self._model_removed_id = manager.connect("removed",
                                                 self._model_removed_cb)

    def __del__(self):
        # STTConfigDialog rebuilds its model on every locale change, backend
        # change and window focus change, so every handler connected here has
        # to come back off again.
        manager = stt_onnxasr_local_model_manager()

        if self._model_added_id:
            manager.disconnect(self._model_added_id)
            self._model_added_id = 0

        if self._model_removed_id:
            manager.disconnect(self._model_removed_id)
            self._model_removed_id = 0

        if self._settings_id:
            self._settings.disconnect(self._settings_id)
            self._settings_id = 0

        if self._model_name is None and self._model_path is not None:
            manager.unregister_custom_model_path(self._model_path)

    def _get_model_from_settings(self):
        models_json_string = self._settings.get_string("onnxasr-models")
        if models_json_string in (None, "None", ""):
            return None

        try:
            models_dict = json.loads(models_json_string)
        except ValueError as error:
            LOG_MSG.warning("malformed onnxasr-models setting (%s)", error)
            return None

        if not isinstance(models_dict, dict):
            return None

        return models_dict.get(self._locale_str, None)

    def _set_model(self, model):
        LOG_MSG.debug("new onnx-asr model (%s, current path=%s / current name=%s)",
                      model, self._model_path, self._model_name)
        if model is None:
            if self._model_name is None and self._model_path is None:
                return

            self._model_name = None
            self._model_path = None
            self._valid_model = False

            self.emit("changed")
            return

        manager = stt_onnxasr_local_model_manager()

        model = model.strip()
        model_name = self._model_name
        model_path = self._model_path

        # For onnx-asr, custom models are HuggingFace repo IDs containing "/"
        if "/" in model:
            if self._model_name is None and self._model_path == model:
                return

            self._model_name = None
            self._model_path = model
            manager.register_custom_model_path(model, self._locale_str)
            # Registered is not the same as downloaded: path_available() now
            # looks at the cache rather than at the registration table.
            self._valid_model = manager.path_available(model)
        else:
            tmp_model_path = manager.get_best_path_for_model(model)
            if self._model_name == model and tmp_model_path == model_path:
                return

            self._model_name = model
            self._model_path = tmp_model_path
            self._valid_model = bool(tmp_model_path is not None)

        if model_path not in [self._model_path, None] and model_name is None:
            manager.unregister_custom_model_path(model_path)

        LOG_MSG.debug("onnx-asr model changed (valid=%i, current path=%s - current name=%s)",
                      self._valid_model, self._model_path, self._model_name)
        self.emit("changed")

    def _models_changed(self, settings, key):
        model = self._get_model_from_settings()
        self._set_model(model)

    def _model_added_cb(self, manager, name, path):
        if self._model_name is not None:
            if name != self._model_name:
                return

            model_path = manager.get_best_path_for_model(name)
            if model_path is None:
                return
            if self._model_path == model_path and self._valid_model:
                return

            self._model_path = model_path
        elif self._model_path != path:
            return

        self._valid_model = True
        self.emit("changed")

    def _model_removed_cb(self, manager, name, path):
        if self._model_name is not None:
            if name != self._model_name:
                return

            # Do not compare paths here. For a catalog model self._model_path
            # is the onnx-asr identifier while the signal carries the cache
            # directory, so the old equality check silently swallowed every
            # removal and left the model marked as available after a delete.
            self._model_path = manager.get_best_path_for_model(name)
            self._valid_model = bool(self._model_path is not None)
        elif self._model_path == path:
            self._valid_model = False
        else:
            return

        self.emit("changed")

    def available(self):
        return self._valid_model

    def get_locale(self):
        return self._locale_str

    def get_name(self):
        return self._model_name

    def get_path(self):
        return self._model_path

    def set_name(self, model_name):
        self._set_model(model_name)

        models_json_string = self._settings.get_string("onnxasr-models")
        if models_json_string in (None, "None", ""):
            models_dict = {}
        else:
            try:
                models_dict = json.loads(models_json_string)
            except ValueError:
                models_dict = {}

        if not isinstance(models_dict, dict):
            models_dict = {}

        models_dict[self._locale_str] = model_name
        models_json_string = json.dumps(models_dict)

        if self._settings_id:
            self._settings.disconnect(self._settings_id)
        self._settings.set_string("onnxasr-models", models_json_string)
        self._settings_id = self._settings.connect("changed::onnxasr-models",
                                                   self._models_changed)
