diff --git a/engine/sttgstonnxasr.py b/engine/sttgstonnxasr.py
index 0a7fd23..6ff9640 100644
--- a/engine/sttgstonnxasr.py
+++ b/engine/sttgstonnxasr.py
@@ -29,6 +29,9 @@ from sttonnxasrmodel import STTOnnxAsrModel
 
 LOG_MSG = logging.getLogger()
 
+# Upper bound on how long stop() may wait for pending transcriptions.
+FINAL_DRAIN_TIMEOUT = 5.0
+
 # onnx_asr is imported where it is used, never at module level: importing it
 # pulls in onnxruntime, whose native library load holds the GIL for a second or
 # more. This module is imported from the IBus main loop
@@ -92,6 +95,9 @@ class STTGstOnnxAsr(STTGstBase):
         self._process_thread = None
         self._stop_processing = False
 
+        self._draining = False
+        self._drain_done = threading.Event()
+
         self._use_partial_results = False
         self._audio_lock = threading.Lock()
 
@@ -206,6 +212,13 @@ class STTGstOnnxAsr(STTGstBase):
 
     def _on_new_sample(self, appsink):
         """Callback when new audio sample arrives."""
+        # While draining final results or tearing down, keep swallowing buffers
+        # but do not queue new work, otherwise the drain can never complete as
+        # long as the mic picks up sound.
+        if self._draining or self._stop_processing:
+            appsink.emit("pull-sample")
+            return Gst.FlowReturn.OK
+
         sample = appsink.emit("pull-sample")
         if sample is None:
             return Gst.FlowReturn.OK
@@ -270,6 +283,8 @@ class STTGstOnnxAsr(STTGstBase):
             recognizer = self._recognizer
             if recognizer is None:
                 self._process_queue.task_done()
+                if self._process_queue.unfinished_tasks == 0:
+                    self._drain_done.set()
                 continue
 
             try:
@@ -290,14 +305,28 @@ class STTGstOnnxAsr(STTGstBase):
                 LOG_MSG.error("onnx-asr transcription error: %s", e, exc_info=True)
 
             self._process_queue.task_done()
+            if self._process_queue.unfinished_tasks == 0:
+                self._drain_done.set()
 
     def _emit_text(self, text):
         self.emit("text", text)
         return False
 
     def get_final_results(self):
-        self._process_audio_buffer(force=True)
-        self._process_queue.join()
+        # Bounded, event based drain. Queue.join() here could block the main
+        # loop indefinitely: the pipeline is still PLAYING at this point and
+        # kept feeding the queue being joined.
+        self._draining = True
+        try:
+            self._process_audio_buffer(force=True)
+
+            self._drain_done.clear()
+            if self._process_queue.unfinished_tasks == 0:
+                return
+            if self._drain_done.wait(FINAL_DRAIN_TIMEOUT) is False:
+                LOG_MSG.warning("timed out draining pending transcriptions")
+        finally:
+            self._draining = False
 
     def get_results(self):
         pass



