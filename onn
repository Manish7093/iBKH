+    def _load_model_thread(self, model_name, restore_state, generation):
+        """Load onnx-asr model. Runs off the main loop."""
+        recognizer = None
         try:
             import onnx_asr
 
             LOG_MSG.info("Loading onnx-asr model: %s", model_name)
