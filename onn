import os
import logging
import threading
from pathlib import Path
from enum import Enum

from gi.repository import GObject, Gio, GLib

LOG_MSG = logging.getLogger()

# HuggingFace cache directory
HF_CACHE_DIR = Path(os.getenv('HF_HOME', str(Path.home() / '.cache' / 'huggingface'))) / 'hub'

# Weight precision requested from onnx-asr. Default is fp32 (full accuracy).
# Set IBUS_STT_ONNXASR_QUANTIZATION=int8 to trade accuracy for roughly a
# quarter of the download and RSS.
_QUANT_ENV = os.getenv("IBUS_STT_ONNXASR_QUANTIZATION", "none").strip().lower()
ONNXASR_QUANTIZATION = None if _QUANT_ENV in ("", "none", "fp32") else _QUANT_ENV

# onnx-asr model catalog: name -> (locale, size, repo_id)
# Sizes are approximate fp32 download sizes, matching the default above. The
# parakeet 0.6b encoder alone is 2.44 GB; the previous numbers here were off by
# roughly 8x. At int8 each entry is about a quarter of what is listed.
ONNXASR_MODELS = {
    "nemo-parakeet-tdt-0.6b-v3": ("multilingual", "~2.5 GB", "istupakov/parakeet-tdt-0.6b-v3-onnx"),
    "nemo-parakeet-tdt-0.6b-v2": ("en", "~2.5 GB", "istupakov/parakeet-tdt-0.6b-v2-onnx"),
    "nemo-parakeet-ctc-0.6b": ("en", "~2.4 GB", "istupakov/parakeet-ctc-0.6b-onnx"),
    "nemo-parakeet-rnnt-0.6b": ("en", "~2.4 GB", "istupakov/parakeet-rnnt-0.6b-onnx"),
    "nemo-canary-1b-v2": ("multilingual", "~4 GB", "istupakov/canary-1b-v2-onnx"),
    "nemo-fastconformer-ru-ctc": ("ru", "~500 MB", "istupakov/nemo-fastconformer-ru-onnx"),
    "nemo-fastconformer-ru-rnnt": ("ru", "~500 MB", "istupakov/nemo-fastconformer-ru-onnx"),
    "gigaam-v2-ctc": ("ru", "~1 GB", "istupakov/gigaam-v2-onnx"),
    "gigaam-v2-rnnt": ("ru", "~1 GB", "istupakov/gigaam-v2-onnx"),
    "gigaam-v3-ctc": ("ru", "~1 GB", "istupakov/gigaam-v3-onnx"),
    "gigaam-v3-rnnt": ("ru", "~1 GB", "istupakov/gigaam-v3-onnx"),
    "gigaam-v3-e2e-ctc": ("ru", "~1 GB", "istupakov/gigaam-v3-onnx"),
    "gigaam-v3-e2e-rnnt": ("ru", "~1 GB", "istupakov/gigaam-v3-onnx"),
    "whisper-base": ("multilingual", "~300 MB", "istupakov/whisper-base-onnx"),
}


def _repo_cache_path(repo_id):
    """Get the HuggingFace cache path for a repo ID."""
    return HF_CACHE_DIR / ("models--" + repo_id.replace("/", "--"))


def _fetch_model_files(model_name):
    """Download a model's files without building any onnxruntime session.

    load_model() would also create the InferenceSessions, i.e. put a second
    multi-hundred-MB copy of the model inside the setup process while
    ibus-engine-stt already holds one.
    """
    try:
        from onnx_asr.loader import create_asr_resolver
    except ImportError:
        # Older onnx-asr without the resolver helper: fall back to the
        # session-building path rather than failing the download.
        import onnx_asr
        LOG_MSG.warning("onnx_asr.loader.create_asr_resolver is missing, "
                        "downloading through load_model()")
        onnx_asr.load_model(model_name)
        return

    resolver = create_asr_resolver(model_name)

    if ONNXASR_QUANTIZATION:
        try:
            resolver.resolve_model(quantization=ONNXASR_QUANTIZATION)
            return
        except Exception as error:
            LOG_MSG.info("no %s weights for %s (%s), downloading fp32",
                         ONNXASR_QUANTIZATION, model_name, error)

    resolver.resolve_model()


def _is_repo_cached(repo_id):
    """Check if a HuggingFace repo is cached locally."""
    snapshots = _repo_cache_path(repo_id) / "snapshots"
    if not snapshots.is_dir():
        return False
    try:
        return any(snapshots.iterdir())
    except OSError:
        return False


class STTDownloadState(float, Enum):
    STOPPED = -1.0
    UNKNOWN_PROGRESS = -0.5
    UNPACKING = -0.6
    ONGOING = 0.0


class STTOnnxAsrModelDescription(GObject.Object):
    __gtype_name__ = "STTOnnxAsrModelDescription"

    def __init__(self, init_model=None):
        super().__init__()
        self.name = init_model.name if init_model is not None else ""
        self.custom = init_model.custom if init_model is not None else False
        self.is_obsolete = False
        self.paths = init_model.paths if init_model is not None else []
        self.size = init_model.size if init_model is not None else ""
        self.type = init_model.type if init_model is not None else ""
        self.locale = init_model.locale if init_model is not None else ""
        self.url = init_model.url if init_model is not None else ""
        self.repo_id = init_model.repo_id if init_model is not None else ""

        self._operation = None
        self.download_progress = STTDownloadState.STOPPED

    def _download_finished(self):
        if self._operation is not None and self._operation.is_cancelled():
            self._operation = None

    def _download_model_thread(self, model_name, status):
        try:
            self.download_progress = STTDownloadState.UNKNOWN_PROGRESS

            if status.is_cancelled():
                self.download_progress = STTDownloadState.STOPPED
                GLib.idle_add(self._download_finished)
                return

            # Fetch the files only: building the sessions here would load a
            # full copy of the model into the setup process.
            _fetch_model_files(model_name)

            if status.is_cancelled():
                self.download_progress = STTDownloadState.STOPPED
                GLib.idle_add(self._download_finished)
                return

            # Update paths after successful download
            if self.repo_id:
                cache_path = _repo_cache_path(self.repo_id)
                if cache_path.is_dir():
                    self.paths = [str(cache_path)]

        except Exception as e:
            LOG_MSG.error("Download error for %s: %s", model_name, e)

        self.download_progress = STTDownloadState.STOPPED
        GLib.idle_add(self._download_finished)

    def stop_downloading(self):
        if self._operation is not None:
            self._operation.cancel()

    def start_downloading(self):
        if self._operation is not None:
            return

        LOG_MSG.debug("start downloading onnx-asr model (%s)", self.name)

        self.download_progress = STTDownloadState.ONGOING
        self._operation = Gio.Cancellable()

        # daemon: a non-daemon thread keeps the setup process alive until a
        # multi-GB download finishes, long after the window is closed.
        download_thread = threading.Thread(
            target=self._download_model_thread,
            args=(self.name, self._operation),
            daemon=True
        )
        download_thread.start()

    def get_best_path_for_model(self):
        if self.paths in [None, []]:
            return None
        return self.paths[0]

    def delete_paths(self):
        if self.custom is True:
            return

        if not self.repo_id:
            return

        import shutil
        cache_path = _repo_cache_path(self.repo_id)
        if cache_path.is_dir():
            try:
                shutil.rmtree(cache_path)
            except Exception as e:
                LOG_MSG.error("Failed to delete %s: %s", cache_path, e)

        self._operation = None
        self.download_progress = STTDownloadState.STOPPED
        self.paths = []


