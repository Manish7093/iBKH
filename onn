--- a/engine/sttgstonnxasr.py
+++ b/engine/sttgstonnxasr.py
@@ -32,6 +32,30 @@ LOG_MSG = logging.getLogger()
 # Upper bound on how long stop() may wait for pending transcriptions.
 FINAL_DRAIN_TIMEOUT = 5.0
 
+def _session_options():
+    """Session options that do not affect results.
+
+    Only settings with no influence on the arithmetic are set here. In
+    particular the intra/inter op thread counts are deliberately left at
+    onnxruntime's defaults: changing them changes the reduction order inside
+    matmuls, which can change the decoded text.
+    """
+    import onnxruntime as ort
+
+    opts = ort.SessionOptions()
+
+    # The thread pool spins while waiting for work, so it keeps burning cycles
+    # between utterances when nobody is dictating.
+    opts.add_session_config_entry("session.intra_op.allow_spinning", "0")
+    opts.add_session_config_entry("session.inter_op.allow_spinning", "0")
+
+    # The BFC arena never hands memory back, which defeats the malloc_trim(0)
+    # in STTGstBase.destroy().
+    opts.enable_cpu_mem_arena = False
+
+    return opts
+
+
 # onnx_asr is imported where it is used, never at module level: importing it
 # pulls in onnxruntime, whose native library load holds the GIL for a second or
 # more. This module is imported from the IBus main loop
@@ -136,7 +160,8 @@ class STTGstOnnxAsr(STTGstBase):
             import onnx_asr
 
             LOG_MSG.info("Loading onnx-asr model: %s", model_name)
-            recognizer = onnx_asr.load_model(model_name)
+            recognizer = onnx_asr.load_model(model_name,
+                                             sess_options=_session_options())
             LOG_MSG.info("onnx-asr model loaded successfully")
 
         except Exception as e:




