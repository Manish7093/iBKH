import gc
import logging
import os
import queue
import threading
import time

import numpy as np

from gi.repository import Gst, Gio, GLib

from sttutils import *
from sttgstbase import STTGstBase
from sttcurrentlocale import stt_current_locale
from sttonnxasrmodel import STTOnnxAsrModel
from sttonnxasrmodelmanagers import stt_onnxasr_load_recognizer

LOG_MSG = logging.getLogger()

# NOTE: onnx_asr is deliberately NOT imported at module scope.
#
#   * importing it pulls in onnxruntime, which spins up thread pools and
#     allocates before the user has dictated anything;
#   * a module level ONNXASR_AVAILABLE flag freezes at first import, so a
#     backend installed while ibus-stt is running would stay "missing" until
#     the daemon restarts. Availability detection belongs to sttbackenddeps.
#
# The import happens in the loader thread, off the main loop.


def _env_float(name, default):
    try:
        return float(os.getenv(name, default))
    except (TypeError, ValueError):
        return float(default)


class STTGstOnnxAsr(STTGstBase):
    __gtype_name__ = 'STTGstOnnxAsr'

    _pipeline_def = "pulsesrc blocksize=3200 buffer-time=9223372036854775807 ! " \
                    "audio/x-raw,format=S16LE,rate=16000,channels=1 ! " \
                    "webrtcdsp noise-suppression-level=3 echo-cancel=false ! " \
                    "queue ! " \
                    "appsink name=OnnxAsrSink emit-signals=true sync=false " \
                    "max-buffers=50 drop=true"

    _pipeline_def_alt = "pulsesrc blocksize=3200 buffer-time=9223372036854775807 ! " \
                        "audio/x-raw,format=S16LE,rate=16000,channels=1 ! " \
                        "queue ! " \
                        "appsink name=OnnxAsrSink emit-signals=true sync=false " \
                        "max-buffers=50 drop=true"

    def __init__(self, current_locale=None):
        plugin = Gst.Registry.get().find_plugin("webrtcdsp")
        if plugin is not None:
            super().__init__(pipeline_definition=STTGstOnnxAsr._pipeline_def)
            LOG_MSG.debug("using Webrtcdsp plugin")
        else:
            super().__init__(pipeline_definition=STTGstOnnxAsr._pipeline_def_alt)
            LOG_MSG.debug("not using Webrtcdsp plugin")

        # ------------------------------------------------------------------
        # Every attribute is initialised before anything can call back into
        # us: the appsink signal, the model signal, the locale signal and
        # __del__ all touch this state.
        # ------------------------------------------------------------------
        self._appsink = None
        self._current_locale = None
        self._locale_id = 0
        self._model = None
        self._model_id = 0

        self._settings = Gio.Settings.new("org.freedesktop.ibus.engine.stt")

        self._sample_rate = 16000
        self._audio_lock = threading.Lock()
        self._audio_buffer = []
        self._buffer_duration = 0.0
        self._silence_duration = 0.0
        self._had_speech = False

        self._max_buffer_duration = _env_float("IBUS_STT_ONNXASR_MAX_CHUNK", 5.0)
        self._min_buffer_duration = _env_float("IBUS_STT_ONNXASR_MIN_CHUNK", 1.0)
        self._silence_flush_duration = _env_float("IBUS_STT_ONNXASR_SILENCE", 0.6)
        self._silence_rms_threshold = _env_float("IBUS_STT_ONNXASR_RMS", 250.0)
        self._final_wait = _env_float("IBUS_STT_ONNXASR_FINAL_WAIT", 4.0)
        self._idle_unload_seconds = _env_float("IBUS_STT_ONNXASR_IDLE_UNLOAD", 180.0)

        self._process_queue = queue.Queue(maxsize=4)
        self._process_thread = None
        self._thread_lock = threading.Lock()
        self._stop_processing = False
        self._idle_event = threading.Event()
        self._idle_event.set()

        self._pending_lock = threading.Lock()
        self._pending_texts = []

        self._recognizer = None
        self._recognizer_name = None
        self._wanted_model_name = None
        self._load_lock = threading.Lock()
        self._load_thread = None
        self._load_generation = 0
        self._unload_timeout_id = 0

        self._use_partial_results = False

        if self.pipeline is None:
            LOG_MSG.error("pipeline was not created")
            return

        self._appsink = self.pipeline.get_by_name("OnnxAsrSink")
        if self._appsink is None:
            LOG_MSG.error("no appsink element!")
            return

        if current_locale is None:
            self._current_locale = stt_current_locale()
        else:
            self._current_locale = current_locale

        self._locale_id = self._current_locale.connect("changed",
                                                       self._locale_changed)
        self._set_model()

        # Connected last: the state above is now consistent.
        self._appsink.connect("new-sample", self._on_new_sample)

    # --------------------------------------------------------------- teardown

    def __del__(self):
        LOG_MSG.info("OnnxAsr __del__")
        self._shutdown_threads()
        try:
            super().__del__()
        except AttributeError:
            pass

    def destroy(self):
        self._cancel_unload()
        self._shutdown_threads()

        if self._current_locale is not None and self._locale_id != 0:
            self._current_locale.disconnect(self._locale_id)
        self._locale_id = 0

        if self._model is not None and self._model_id != 0:
            self._model.disconnect(self._model_id)
        self._model_id = 0

        self._appsink = None
        self._release_recognizer()

        LOG_MSG.info("OnnxAsr.destroy() called")
        super().destroy()

    def _shutdown_threads(self):
        self._stop_processing = True

        worker = getattr(self, "_process_thread", None)
        if worker is not None and worker.is_alive():
            worker.join(timeout=2.0)
        self._process_thread = None

        # Bumping the generation makes any in-flight load discard its result.
        # The loader is a daemon thread and may be blocked on a several
        # hundred megabyte download, so it is not waited on for long.
        self._load_generation += 1
        loader = getattr(self, "_load_thread", None)
        if loader is not None and loader.is_alive():
            loader.join(timeout=0.5)
        self._load_thread = None

    def _release_recognizer(self):
        self._recognizer = None
        self._recognizer_name = None
        gc.collect()

    # ----------------------------------------------------------- model wiring

    def _set_model_path(self):
        if self._model is None or self._model.available() is False:
            LOG_MSG.info("model not available (%s - %s)",
                         self._model.get_name() if self._model else "None",
                         self._model.get_path() if self._model else "None")
            self._wanted_model_name = None
            self._release_recognizer()
            self.emit("model-changed")
            return

        model_name = self._model.get_path()
        LOG_MSG.debug("model ready %s", model_name)

        if model_name != self._wanted_model_name:
            self._wanted_model_name = model_name
            if self._recognizer_name != model_name:
                self._release_recognizer()

        # Tell the UI the selection changed immediately. The expensive part is
        # deferred: has_model() does not depend on the recognizer being
        # resident, so the config dialog stays accurate either way.
        self.emit("model-changed")

        if self._preload_enabled():
            self._ensure_recognizer_async()

    def _model_changed(self, model):
        self._set_model_path()

    def _set_model(self):
        if self._model is not None and \
           self._model.get_locale() == self._current_locale.locale:
            return

        if self._model is not None and self._model_id != 0:
            self._model.disconnect(self._model_id)
            self._model_id = 0

        self._model = STTOnnxAsrModel(locale_str=self._current_locale.locale)
        self._model_id = self._model.connect("changed", self._model_changed)
        self._set_model_path()

    def _locale_changed(self, locale):
        self._set_model()

    # -------------------------------------------------------- model residency

    def _preload_enabled(self):
        try:
            return self._settings.get_boolean("preload")
        except Exception:
            return False

    def preload(self):
        """Warm up ahead of the first utterance.

        STTConfigDialog calls this on every engine it builds, including the
        throwaway one it keeps for the shortcut recorder. Loading a 0.6b
        parakeet there would double the resident size for as long as the
        preferences window is open, so the model is only made resident when
        the user has actually asked for preloading.
        """
        try:
            super().preload()
        except AttributeError:
            pass

        if self._preload_enabled():
            self._ensure_recognizer_async()

    def _ensure_recognizer_async(self):
        """Start loading the wanted model off the main loop. Idempotent."""
        with self._load_lock:
            name = self._wanted_model_name
            if name is None:
                return
            if self._recognizer is not None and self._recognizer_name == name:
                return
            if self._load_thread is not None and self._load_thread.is_alive():
                return

            self._load_generation += 1
            generation = self._load_generation
            self._load_thread = threading.Thread(target=self._load_worker,
                                                 args=(name, generation),
                                                 name="onnxasr-loader",
                                                 daemon=True)
            self._load_thread.start()

        self._cancel_unload()

    def _load_worker(self, model_name, generation):
        # Drop the previous recognizer first: holding both alive across a
        # model switch doubles peak RSS.
        self._recognizer = None
        self._recognizer_name = None
        gc.collect()

        recognizer = None
        try:
            recognizer = stt_onnxasr_load_recognizer(model_name)
        except Exception as error:
            LOG_MSG.error("failed to load onnx-asr model %s (%s)",
                          model_name, error, exc_info=True)

        if generation != self._load_generation:
            LOG_MSG.debug("discarding stale load of %s", model_name)
            del recognizer
            gc.collect()
            return

        self._recognizer = recognizer
        self._recognizer_name = model_name if recognizer is not None else None

        if recognizer is not None:
            LOG_MSG.info("onnx-asr model loaded: %s", model_name)

        GLib.idle_add(self._load_finished)

    def _load_finished(self):
        self.emit("model-changed")
        return False

    def unload_model(self):
        """Release the recognizer so RSS drops back while idle."""
        if self._recognizer is None:
            return
        LOG_MSG.info("unloading idle onnx-asr model (%s)", self._recognizer_name)
        self._release_recognizer()

    def _cancel_unload(self):
        if self._unload_timeout_id != 0:
            GLib.source_remove(self._unload_timeout_id)
            self._unload_timeout_id = 0

    def _schedule_unload(self):
        self._cancel_unload()

        if self._idle_unload_seconds <= 0:
            return
        if self._preload_enabled():
            # The user explicitly traded memory for latency.
            return

        self._unload_timeout_id = GLib.timeout_add_seconds(
            int(self._idle_unload_seconds), self._unload_timeout_cb)

    def _unload_timeout_cb(self):
        self._unload_timeout_id = 0
        self.unload_model()
        return False

    # --------------------------------------------------------- audio capture

    def _on_new_sample(self, appsink):
        sample = appsink.emit("pull-sample")
        if sample is None:
            return Gst.FlowReturn.OK

        buf = sample.get_buffer()
        success, map_info = buf.map(Gst.MapFlags.READ)
        if not success:
            return Gst.FlowReturn.OK

        try:
            # copy() matters: depending on the PyGObject version map_info.data
            # can be a view over memory that unmap() invalidates, and these
            # arrays outlive the callback.
            audio_data = np.frombuffer(map_info.data, dtype=np.int16).copy()
        finally:
            buf.unmap(map_info)

        if audio_data.size == 0:
            return Gst.FlowReturn.OK

        # Audio arriving means the user is dictating: that is the point at
        # which the model is worth paying for.
        if self._recognizer is None:
            self._ensure_recognizer_async()
        else:
            self._cancel_unload()

        rms = float(np.sqrt(np.mean(np.square(audio_data.astype(np.float32)))))
        chunk_seconds = len(audio_data) / self._sample_rate

        with self._audio_lock:
            self._audio_buffer.append(audio_data)
            self._buffer_duration += chunk_seconds

            if rms < self._silence_rms_threshold:
                self._silence_duration += chunk_seconds
            else:
                self._silence_duration = 0.0
                self._had_speech = True

            flush = self._buffer_duration >= self._max_buffer_duration or \
                (self._had_speech
                 and self._buffer_duration >= self._min_buffer_duration
                 and self._silence_duration >= self._silence_flush_duration)

        if flush:
            self._process_audio_buffer(force=True)

        return Gst.FlowReturn.OK

    def _process_audio_buffer(self, force=False):
        with self._audio_lock:
            if not self._audio_buffer:
                return

            if not force and self._buffer_duration < self._min_buffer_duration:
                return

            audio = np.concatenate(self._audio_buffer)
            had_speech = self._had_speech

            self._audio_buffer.clear()
            self._buffer_duration = 0.0
            self._silence_duration = 0.0
            self._had_speech = False

        if not had_speech:
            # Pure silence: skip the inference pass entirely.
            return

        if self._recognizer is None:
            LOG_MSG.debug("dropping %.2fs of audio, recognizer not ready",
                          len(audio) / self._sample_rate)
            self._ensure_recognizer_async()
            return

        LOG_MSG.debug("queueing %d samples (%.2fs)",
                      len(audio), len(audio) / self._sample_rate)
        self._enqueue(audio.astype(np.float32) / 32768.0)

    def _enqueue(self, audio):
        self._idle_event.clear()

        while True:
            try:
                self._process_queue.put_nowait(audio)
                break
            except queue.Full:
                try:
                    self._process_queue.get_nowait()
                    self._process_queue.task_done()
                    LOG_MSG.warning("transcription backlog, dropping oldest chunk")
                except queue.Empty:
                    pass

        self._ensure_worker()

    def _ensure_worker(self):
        with self._thread_lock:
            if self._stop_processing:
                return
            if self._process_thread is not None and self._process_thread.is_alive():
                return
            self._process_thread = threading.Thread(target=self._process_worker,
                                                    name="onnxasr-worker",
                                                    daemon=True)
            self._process_thread.start()

    def _process_worker(self):
        while not self._stop_processing:
            try:
                audio = self._process_queue.get(timeout=0.2)
            except queue.Empty:
                self._idle_event.set()
                continue

            try:
                recognizer = self._recognizer
                if recognizer is None:
                    LOG_MSG.debug("recognizer went away, dropping chunk")
                else:
                    text = recognizer.recognize(audio,
                                                sample_rate=self._sample_rate)
                    if isinstance(text, str):
                        text = text.strip()
                    if text:
                        LOG_MSG.info("onnx-asr transcription result: '%s'", text)
                        self._queue_text(text)
                    else:
                        LOG_MSG.debug("no text transcribed from audio")
            except Exception as error:
                LOG_MSG.error("onnx-asr transcription error (%s)",
                              error, exc_info=True)
            finally:
                # Always paired with get(): nothing may wait on this forever.
                self._process_queue.task_done()
                if self._process_queue.empty():
                    self._idle_event.set()

        self._idle_event.set()

    # ------------------------------------------------------------ result path

    def _queue_text(self, text):
        with self._pending_lock:
            self._pending_texts.append(text)
        GLib.idle_add(self._emit_pending)

    def _emit_pending(self):
        with self._pending_lock:
            texts = self._pending_texts
            self._pending_texts = []

        for text in texts:
            self.emit("text", text)

        return False

    def get_final_results(self):
        self._process_audio_buffer(force=True)

        # A bounded wait, not Queue.join(): a worker that died on an unhandled
        # exception, or a chunk enqueued after shutdown, must never wedge the
        # main loop.
        deadline = time.monotonic() + self._final_wait
        while not self._idle_event.is_set() and time.monotonic() < deadline:
            self._idle_event.wait(0.05)

        if not self._idle_event.is_set():
            LOG_MSG.warning("timed out draining onnx-asr transcription queue")

        self._emit_pending()

    def get_results(self):
        pass

    def set_use_partial_results(self, active):
        self._use_partial_results = active

    def set_alternatives_num(self, num):
        pass

    def has_model(self):
        if self._model is None or self._model.available() is False:
            return False
        return super().has_model()

    def _stop_real(self):
        self.get_final_results()
        self._schedule_unload()
        return super()._stop_real()


