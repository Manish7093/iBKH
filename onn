# Upper bound on how long stop() may wait for pending transcriptions.
FINAL_DRAIN_TIMEOUT = 5.0

# onnx_asr (and onnxruntime under it) is imported from the loader thread only.
# "import onnxruntime" dlopen()s a large native library and holds the GIL while
# doing it; this module is imported from the IBus main loop
# (STTGstFactory.new_engine()) and from the setup dialog
# (stt_backend_component()), so a top-level import freezes both before the
# async load below even starts. Same pattern as sttgstmoonshine.


def _session_options():
    import onnxruntime as ort

    opts = ort.SessionOptions()

    # onnxruntime defaults to one intra-op thread per physical core, and the
    # pool spins waiting for work. For a background input method that pins the
    # machine during a chunk and keeps burning cycles between utterances -
    # which is what starves the shell and the setup dialog.
    opts.intra_op_num_threads = max(1, min(4, (os.cpu_count() or 2) // 2))
    opts.inter_op_num_threads = 1
    opts.execution_mode = ort.ExecutionMode.ORT_SEQUENTIAL
    opts.add_session_config_entry("session.intra_op.allow_spinning", "0")
    opts.add_session_config_entry("session.inter_op.allow_spinning", "0")

    # The BFC arena never hands memory back, defeating the malloc_trim(0) in
    # STTGstBase.destroy(). With 6 s chunks the reuse isn't worth it.
    opts.enable_cpu_mem_arena = False

    return opts


def _load_recognizer(model_name):
    import onnx_asr

    opts = _session_options()

    if ONNXASR_QUANTIZATION:
        try:
            return onnx_asr.load_model(model_name,
                                       quantization=ONNXASR_QUANTIZATION,
                                       sess_options=opts)
        except Exception as error:
            LOG_MSG.info("no %s weights for %s (%s), falling back to fp32",
                         ONNXASR_QUANTIZATION, model_name, error)

    return onnx_asr.load_model(model_name, sess_options=opts)


