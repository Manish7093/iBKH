# sttvad.py
"""
Stream-oriented Voice Activity Detector.

Primary backend : auditok  (pip install auditok)  — energy-based, pure numpy,
                  handles onset/offset state machine internally.
Fallback backend: energy-based state machine (pure numpy, always available).

External API (process / flush / reset / backend_name) is identical for both
backends — sttgstwhisper.py requires only one small addition (see bottom).
"""

import logging
import numpy as np
from collections import deque

LOG_MSG = logging.getLogger()

try:
    import auditok as _auditok
    _AUDITOK_OK = True
    LOG_MSG.info("STTVad: auditok backend available")
except ImportError:
    _AUDITOK_OK = False
    LOG_MSG.info(
        "STTVad: auditok not installed (pip install auditok). "
        "Using energy-based fallback.")


class STTVad:
    """
    Stream-oriented Voice Activity Detector.

    Feed raw PCM float32 audio (16 kHz, mono) in arbitrary chunk sizes via
    :meth:`process`. Complete speech *segments* (numpy float32 arrays) are
    returned whenever an utterance ends. Call :meth:`flush` before stopping
    to retrieve any incomplete final segment.

    Parameters
    ----------
    speech_threshold : float
        Unused, kept for API compatibility.
    silence_duration_ms : int
        Continuous silence (ms) required to mark the end of an utterance.
    speech_pad_ms : int
        Silence retained immediately before/after each detected event.
    min_speech_duration_ms : int
        Segments shorter than this are discarded.
    max_speech_duration_s : float
        Force-split a segment if it grows beyond this length.
    freq_thold : float
        Energy fallback only: spectral gate high-pass threshold in Hz.
    low_energy_ratio : float
        Energy fallback only: spectral gate sensitivity.
    rms_threshold : float
        Energy fallback only: per-chunk RMS threshold.
    speech_confirm_chunks : int
        Energy fallback only: consecutive speech chunks required for onset.
    min_segment_rms : float
        Both backends: whole-segment RMS gate before sending to Whisper.
        Catches near-silence segments that slipped through chunk-level checks.
    webrtc_aggressiveness : int
        Unused, kept for API compatibility.
    energy_threshold_db : float
        Auditok only: detection threshold in dB (default 55).
        Maps roughly to float32 RMS 0.018 (55 dB ≈ 590 on int16 scale).
        Raise to 58–62 for noisy environments or to reduce Hindi hallucinations.
    """

    SAMPLE_RATE  = 16000
    SAMPLE_WIDTH = 2      # int16 = 2 bytes per sample
    CHANNELS     = 1

    _ENERGY_CHUNK = 320   # 20 ms @ 16 kHz (energy fallback only)

    def __init__(
        self,
        speech_threshold: float = 0.5,
        silence_duration_ms: int = 800,
        speech_pad_ms: int = 200,
        min_speech_duration_ms: int = 500,
        max_speech_duration_s: float = 15.0,
        freq_thold: float = 100.0,
        low_energy_ratio: float = 0.80,
        rms_threshold: float = 0.018,
        speech_confirm_chunks: int = 3,
        min_segment_rms: float = 0.020,
        webrtc_aggressiveness: int = 2,
        energy_threshold_db: float = 55.0,
    ):
        # Shared params
        self._min_dur         = min_speech_duration_ms / 1000.0
        self._max_dur         = max_speech_duration_s
        self._max_silence     = silence_duration_ms    / 1000.0
        self._speech_pad      = speech_pad_ms          / 1000.0
        self._min_segment_rms = min_segment_rms

        if _AUDITOK_OK:
            self._energy_db = energy_threshold_db
            self._buffer    = np.empty(0, dtype=np.float32)
        else:
            # Energy fallback — per-chunk state machine
            self._freq_thold            = freq_thold
            self._low_energy_ratio      = low_energy_ratio
            self._rms_threshold         = rms_threshold
            self._speech_confirm_chunks = speech_confirm_chunks

            self._silence_samples    = int(silence_duration_ms    * self.SAMPLE_RATE / 1000)
            self._min_speech_samples = int(min_speech_duration_ms * self.SAMPLE_RATE / 1000)
            self._max_speech_samples = int(max_speech_duration_s  * self.SAMPLE_RATE)

            pad_chunks = max(1, int(speech_pad_ms * self.SAMPLE_RATE / 1000)
                             // self._ENERGY_CHUNK)
            self._pre_buf         = deque(maxlen=pad_chunks)
            self._leftover        = np.empty(0, dtype=np.float32)
            self._speech_chunks   = []
            self._speech_samples  = 0
            self._in_speech       = False
            self._silence_counter = 0
            self._confirm_buf     = []
            self._confirm_counter = 0

        LOG_MSG.info(
            "STTVad ready -- backend=%s | silence=%.1fs | min=%.1fs | "
            "max=%.1fs | pad=%.1fs | min_seg_rms=%.3f%s",
            self.backend_name,
            self._max_silence, self._min_dur, self._max_dur,
            self._speech_pad, self._min_segment_rms,
            f" | energy_db={energy_threshold_db:.1f}" if _AUDITOK_OK
            else f" | rms={rms_threshold} | confirm={speech_confirm_chunks}ch")

    # ------------------------------------------------------------------
    # Properties
    # ------------------------------------------------------------------

    @property
    def is_silero(self) -> bool:
        """Kept for API compatibility."""
        return False

    @property
    def backend(self) -> str:
        return "auditok" if _AUDITOK_OK else "energy"

    @property
    def backend_name(self) -> str:
        return "Auditok VAD" if _AUDITOK_OK else "Energy-based VAD"

    # ------------------------------------------------------------------
    # Public interface
    # ------------------------------------------------------------------

    def reset(self) -> None:
        """Reset all internal state (call when starting a new recording)."""
        if _AUDITOK_OK:
            self._buffer = np.empty(0, dtype=np.float32)
        else:
            self._pre_buf.clear()
            self._leftover        = np.empty(0, dtype=np.float32)
            self._speech_chunks   = []
            self._speech_samples  = 0
            self._in_speech       = False
            self._silence_counter = 0
            self._confirm_buf     = []
            self._confirm_counter = 0

    def process(self, audio: np.ndarray) -> list:
        """
        Feed incoming audio; return list of completed speech segments.

        Parameters
        ----------
        audio : np.ndarray
            Float32 PCM, 16 kHz, mono. Any length is accepted.

        Returns
        -------
        list of np.ndarray
            Zero or more completed speech segments ready for transcription.
        """
        if _AUDITOK_OK:
            return self._auditok_process(audio)
        return self._energy_process(audio)

    def flush(self):
        """
        Flush remaining buffered speech. Call when recording stops so
        the last utterance is not lost.

        Returns
        -------
        np.ndarray or None
        """
        if _AUDITOK_OK:
            return self._auditok_flush()
        return self._energy_flush()

    # ------------------------------------------------------------------
    # Auditok backend
    # ------------------------------------------------------------------

    def _auditok_process(self, audio: np.ndarray) -> list:
        self._buffer = np.concatenate([self._buffer, audio])

        buf_dur = len(self._buffer) / self.SAMPLE_RATE
        # Need at least min_dur + max_silence of audio before any
        # segment can be confirmed complete.
        if buf_dur < self._min_dur + self._max_silence:
            return []

        # Convert buffer to int16 bytes for auditok
        int16     = (np.clip(self._buffer, -1.0, 1.0) * 32767).astype(np.int16)
        raw_bytes = int16.tobytes()

        try:
            events = list(_auditok.split(
                raw_bytes,
                sampling_rate=self.SAMPLE_RATE,
                sample_width=self.SAMPLE_WIDTH,
                channels=self.CHANNELS,
                min_dur=self._min_dur,
                max_dur=self._max_dur,
                max_silence=self._max_silence,
                max_leading_silence=self._speech_pad,
                max_trailing_silence=self._speech_pad,
                energy_threshold=self._energy_db,
            ))
        except Exception as exc:
            LOG_MSG.warning("STTVad: auditok split error: %s", exc)
            return []

        # A segment is "confirmed complete" only when at least max_silence
        # seconds of silence follow it in the buffer — i.e. its end time is
        # well before the end of the buffer.
        confirm_cutoff = buf_dur - self._max_silence
        completed      = []
        last_end_sec   = 0.0

        for event in events:
            if event.end > confirm_cutoff:
                # Potentially still being spoken — leave in buffer.
                break

            seg = event.numpy()[0].astype(np.float32) / 32768.0
            rms = float(np.sqrt(np.mean(seg ** 2)))

            if rms >= self._min_segment_rms:
                completed.append(seg)
                LOG_MSG.debug(
                    "VAD: %.2fs–%.2fs emitted (rms=%.3f, dur=%.2fs)",
                    event.start, event.end, rms, event.end - event.start)
            else:
                LOG_MSG.debug(
                    "VAD: %.2fs–%.2fs discarded (rms=%.3f < min %.3f)",
                    event.start, event.end, rms, self._min_segment_rms)

            last_end_sec = event.end

        if last_end_sec > 0.0:
            # Trim consumed audio from the buffer.
            # Keep speech_pad of audio before last_end so the next
            # onset gets a natural pre-roll.
            keep_from    = max(0.0, last_end_sec - self._speech_pad)
            self._buffer = self._buffer[int(keep_from * self.SAMPLE_RATE):]
        else:
            # No segment emitted yet — cap buffer to avoid unbounded growth
            # during continuous speech that has not paused.
            max_buf = int((self._max_dur + self._max_silence) * self.SAMPLE_RATE)
            if len(self._buffer) > max_buf:
                self._buffer = self._buffer[-max_buf:]

        return completed

    def _auditok_flush(self):
        buf          = self._buffer.copy()
        self._buffer = np.empty(0, dtype=np.float32)

        if len(buf) == 0:
            return None

        dur = len(buf) / self.SAMPLE_RATE
        if dur < self._min_dur:
            LOG_MSG.debug("VAD flush: too short (%.3fs < %.3fs min)", dur, self._min_dur)
            return None

        rms = float(np.sqrt(np.mean(buf ** 2)))
        if rms < self._min_segment_rms:
            LOG_MSG.debug(
                "VAD flush: discarded (rms=%.3f < min %.3f)", rms, self._min_segment_rms)
            return None

        LOG_MSG.debug("VAD flush: %.2fs emitted (rms=%.3f)", dur, rms)
        return buf

    # ------------------------------------------------------------------
    # Energy fallback backend
    # ------------------------------------------------------------------

    def _energy_process(self, audio: np.ndarray) -> list:
        completed = []

        if len(self._leftover):
            audio = np.concatenate([self._leftover, audio])
        self._leftover = np.empty(0, dtype=np.float32)

        offset = 0
        while offset + self._ENERGY_CHUNK <= len(audio):
            chunk   = audio[offset: offset + self._ENERGY_CHUNK]
            offset += self._ENERGY_CHUNK

            if self._freq_thold > 0.0 and not self._spectral_gate(chunk):
                self._energy_on_silence(chunk, completed)
                continue

            is_speech, conf = self._energy_classify(chunk)
            if is_speech:
                self._energy_on_speech(chunk, conf, completed)
            else:
                self._energy_on_silence(chunk, completed)

        if offset < len(audio):
            self._leftover = audio[offset:].copy()

        return completed

    def _energy_flush(self):
        # Discard unconfirmed onset — too short to be real speech.
        self._confirm_buf     = []
        self._confirm_counter = 0

        segment = None
        if self._in_speech and self._speech_samples >= self._min_speech_samples:
            parts = list(self._speech_chunks)
            if len(self._leftover):
                parts.append(self._leftover)
            candidate = np.concatenate(parts).astype(np.float32)
            if self._segment_rms_ok(candidate):
                segment = candidate
                LOG_MSG.debug("VAD flush: %.2fs emitted", len(segment) / self.SAMPLE_RATE)

        self._speech_chunks   = []
        self._speech_samples  = 0
        self._silence_counter = 0
        self._in_speech       = False
        self._leftover        = np.empty(0, dtype=np.float32)
        return segment

    def _spectral_gate(self, chunk: np.ndarray) -> bool:
        n            = len(chunk)
        fft_mag      = np.abs(np.fft.rfft(chunk))
        freqs        = np.fft.rfftfreq(n, d=1.0 / self.SAMPLE_RATE)
        energy_total = float(np.dot(fft_mag, fft_mag))
        if energy_total < 1e-12:
            return False
        low_mask   = freqs < self._freq_thold
        energy_low = float(np.dot(fft_mag[low_mask], fft_mag[low_mask]))
        return (energy_low / energy_total) < self._low_energy_ratio

    def _energy_classify(self, chunk: np.ndarray) -> tuple:
        rms = float(np.sqrt(np.mean(chunk ** 2)))
        return rms >= self._rms_threshold, rms

    def _segment_rms_ok(self, segment: np.ndarray) -> bool:
        if self._min_segment_rms <= 0.0:
            return True
        rms = float(np.sqrt(np.mean(segment ** 2)))
        if rms < self._min_segment_rms:
            LOG_MSG.debug(
                "VAD: segment rms %.4f < min %.4f — discarded", rms, self._min_segment_rms)
            return False
        return True

    def _energy_on_speech(self, chunk, confidence, out):
        if not self._in_speech:
            # Confirmation hysteresis: require N consecutive speech chunks
            # before declaring onset. Prevents noise spikes triggering Whisper.
            self._confirm_buf.append(chunk)
            self._confirm_counter += 1
            if self._confirm_counter < self._speech_confirm_chunks:
                return

            LOG_MSG.debug(
                "VAD: speech onset confirmed after %d chunks (conf=%.3f)",
                self._confirm_counter, confidence)
            self._in_speech       = True
            self._silence_counter = 0

            for pc in self._pre_buf:
                self._speech_chunks.append(pc)
                self._speech_samples += len(pc)
            for bc in self._confirm_buf:
                self._speech_chunks.append(bc)
                self._speech_samples += len(bc)

            self._confirm_buf     = []
            self._confirm_counter = 0
        else:
            self._speech_chunks.append(chunk)
            self._speech_samples  += len(chunk)
            self._silence_counter  = 0

            if self._speech_samples >= self._max_speech_samples:
                LOG_MSG.debug("VAD: max duration reached — intermediate flush")
                candidate = np.concatenate(self._speech_chunks).astype(np.float32)
                if self._segment_rms_ok(candidate):
                    out.append(candidate)
                self._speech_chunks  = []
                self._speech_samples = 0

    def _energy_on_silence(self, chunk, out):
        if not self._in_speech:
            if self._confirm_counter > 0:
                LOG_MSG.debug(
                    "VAD: noise spike rejected (%d/%d chunks)",
                    self._confirm_counter, self._speech_confirm_chunks)
                self._confirm_buf     = []
                self._confirm_counter = 0
            self._pre_buf.append(chunk)
            return

        self._speech_chunks.append(chunk)
        self._speech_samples  += len(chunk)
        self._silence_counter += len(chunk)

        if self._silence_counter >= self._silence_samples:
            duration = self._speech_samples / self.SAMPLE_RATE
            LOG_MSG.debug("VAD: speech end (%.2fs)", duration)

            if self._speech_samples >= self._min_speech_samples:
                candidate = np.concatenate(self._speech_chunks).astype(np.float32)
                if self._segment_rms_ok(candidate):
                    out.append(candidate)
                else:
                    LOG_MSG.debug("VAD: discarded at RMS gate")
            else:
                LOG_MSG.debug(
                    "VAD: too short (%.3fs < %.3fs min)", duration, self._min_dur)

            self._speech_chunks   = []
            self._speech_samples  = 0
            self._silence_counter = 0
            self._in_speech       = False
            self._pre_buf.append(chunk)













