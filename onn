From a44ab67467866097332d29f16c63c40d74fa8c12 Mon Sep 17 00:00:00 2001
From: p <p@x>
Date: Fri, 18 Sep 2026 16:52:35 +0000
Subject: [PATCH 1/6] onnxasr: build the engine in the setup dialog only on
 demand

---
 engine/sttconfigdialog.py | 49 +++++++++++++++++++++++++--------------
 1 file changed, 31 insertions(+), 18 deletions(-)

diff --git a/engine/sttconfigdialog.py b/engine/sttconfigdialog.py
index 61c2b54..8a97405 100644
--- a/engine/sttconfigdialog.py
+++ b/engine/sttconfigdialog.py
@@ -141,7 +141,8 @@ class STTConfigDialog (Adw.Window):
         # This updates _valid_formatting_file and _valid_override_file
         self._load_utterances()
 
-        self._create_engine()
+        # No engine here: see _ensure_engine(). Building one loads a second
+        # copy of the ASR model into the setup process.
 
         self._update_voice_commands_visibility()
 
@@ -222,26 +223,35 @@ class STTConfigDialog (Adw.Window):
                 row.set_subtitle(_("Not installed"))
 
 
-    def _create_engine(self):
-        # Instantiate the recognition engine matching the current backend.
-        # Tear down existing engine if present
+    def _destroy_engine(self):
+        # Tear down the existing engine if present.
+        if self._engine is None:
+            return
+
+        try:
+            self._engine.disconnect_by_func(self._engine_model_changed_cb)
+        except TypeError:
+            pass
+        self._engine.destroy()
+        self._engine = None
+
+    def _ensure_engine(self):
+        # Built on demand only. Constructing a backend engine loads the ASR
+        # model into *this* process on top of the copy ibus-engine-stt already
+        # has, and preload() also opens the microphone. Only the shortcut
+        # dialog needs a live engine.
         if self._engine is not None:
-            try:
-                self._engine.disconnect_by_func(self._engine_model_changed_cb)
-            except TypeError:
-                pass
-            self._engine.destroy()
-            self._engine = None
+            return self._engine
 
         backend = self._backend()
         if not stt_backend_is_available(backend):
             LOG_MSG.warning("backend %s is missing its dependencies, "
                             "no engine created", backend)
-            return
+            return None
 
         engine_class = stt_backend_component(backend, "engine")
         if engine_class is None:
-            return
+            return None
 
         try:
             self._engine = engine_class(current_locale=self._current_locale)
@@ -249,12 +259,13 @@ class STTConfigDialog (Adw.Window):
             LOG_MSG.error("cannot create engine for backend %s (%s)",
                           backend, error)
             self._engine = None
-            return
+            return None
 
         self._engine.connect("model-changed", self._engine_model_changed_cb)
         self._engine.preload()
         LOG_MSG.debug("engine created (backend=%s), has_model=%s",
                       backend, self._engine.has_model())
+        return self._engine
 
     def _populate_locale_list(self):
         self._locale_list.clear()
@@ -547,8 +558,9 @@ class STTConfigDialog (Adw.Window):
             self._missing_deps_toast.dismiss()
             self._missing_deps_toast = None
 
-        if (self._model is None or not self._model.available()
-                or self._engine is None or not self._engine.has_model()):
+        # Model availability only: asking the engine would force it to be
+        # built, and with it a second copy of the model.
+        if self._model is None or not self._model.available():
             self._engine_has_no_model()
             return
 
@@ -602,7 +614,7 @@ class STTConfigDialog (Adw.Window):
     def _reload_backend(self, prompt_download=False):
         self._refresh_locale_dropdown()
         self._init_model()
-        self._create_engine()
+        self._destroy_engine()
         self._update_voice_commands_visibility()
         self._empty_shortcut_page()
         self._load_utterances()
@@ -805,12 +817,13 @@ class STTConfigDialog (Adw.Window):
         self._present_shortcut_dialog(row)
 
     def _present_shortcut_dialog(self, row):
-        if self._engine is None:
+        engine = self._ensure_engine()
+        if engine is None:
             LOG_MSG.warning("no engine available, cannot edit shortcuts")
             return
 
         dialog = STTShortcutDialog(
-            row=row, engine=self._engine, transient_for=self)
+            row=row, engine=engine, transient_for=self)
         dialog.connect("response", self._shortcut_dialog_response_cb)
         dialog.present()




